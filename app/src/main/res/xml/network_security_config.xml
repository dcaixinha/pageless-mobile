<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Release configuration: cleartext HTTP is disallowed, so servers must be
      reached over HTTPS.

      Trust anchors include *user-added* CAs as well as the system store. From
      API 24 Android excludes user CAs by default, which would lock out a
      self-hoster who terminates TLS with their own internal CA — a common
      setup for a LAN-only audiobook server, and one where a publicly trusted
      certificate can be awkward to obtain. Those users cannot use the app at
      all without this, whereas the added exposure requires an attacker who has
      already got a CA installed on the device: installing one is a deliberate
      trip through Android Settings, past explicit warnings, and leaves a
      persistent "network may be monitored" notification in place.

      This also covers self-signed certificates, which Android accepts when
      installed as a user CA.

      Do not read this as permission to relax TLS further. The app must never
      disable hostname verification or install a permissive TrustManager;
      trusting an anchor the device owner deliberately added is a different
      thing from trusting anything presented.

      Local development uses app/src/debug/res/xml/network_security_config.xml,
      which relaxes this to permit cleartext to LAN hosts.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
