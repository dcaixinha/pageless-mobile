root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = off

# ktlint configuration.
#
# `function-naming` is disabled because Jetpack Compose @Composable functions
# are intentionally PascalCase (e.g. `SettingsScreen`, `PagelessTheme`), which
# ktlint's standard rule would otherwise flag.
ktlint_standard_function-naming = disabled
